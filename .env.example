# Copy to .env and fill in. .env is git-ignored: never commit it.
# Real environment variables take precedence over .env.

# ---- Model (via LiteLLM) -------------------------------------------------------
# Any LiteLLM model string that supports vision + tool calling. Switching = this line.
LLM_MODEL=gemini/gemma-4-26b-a4b-it
# Gemini API key from https://aistudio.google.com/apikey (starts with "AQ." or "AIza").
GEMINI_API_KEY=
# Other providers, if you switch LLM_MODEL:
# LLM_MODEL=openrouter/nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_API_KEY=

# Optional sampling settings. Empty = provider default.
LLM_TEMPERATURE=
# Includes the model's reasoning tokens for reasoning models: keep it generous.
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_S=120
# Retries on transient provider errors (500/503/connection); each one is recorded.
LLM_NUM_RETRIES=3

# ---- Agent ---------------------------------------------------------------------
AGENT_VARIANT=baseline
# Lab safety net only (max model calls per run). Not a guardrail.
MAX_STEPS=25

# ---- Human approval ----------------------------------------------------------------
# Decided by the version key: prompt_only_human and guarded_human make every action (e-mail,
# Master's registration, graduation notice) wait for a staff member (web UI tab "موافقات الموظف").
# Only refinement: flagged = guarded_human sends only warning cases to staff.
HUMAN_APPROVAL=off
# A text-layer line counts as hidden if less than this share of its words is visible on the page
# HIDDEN_TEXT_THRESHOLD=0.5

# ---- Privacy ---------------------------------------------------------------------
# redact: traces keep no document text, and numbers/names/e-mails/phones become pseudonyms (default)
# full:   keep everything (debugging on your own machine only)
TRACE_PII=redact
# Secret for the pseudonyms. If unset, one is created in runs/.pseudonym_key (git-ignored).
# TRACE_PSEUDONYM_KEY=

# ---- Web UI ----------------------------------------------------------------------
# on: requesters log in with national number + their registered e-mail; staff with STAFF_KEY.
UI_AUTH=on
# If unset, a key is created in runs/.staff_key and printed when the UI starts.
# STAFF_KEY=
# 127.0.0.1 = this computer only. 0.0.0.0 = the whole network (trusted networks only).
# HOST=127.0.0.1

# ---- Documents -----------------------------------------------------------------
PAGE_RENDER_DPI=150
MAX_IMAGE_SIDE=2000
MAX_PAGES_PER_DOCUMENT=10
# OCR for images and PDF pages without a text layer: "tesseract" or "none"
OCR_ENGINE=tesseract
OCR_LANG=ara+eng
# Only if tesseract is not on your PATH (typical on Windows):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Data ----------------------------------------------------------------------
# P1 synthetic registry (data/p1/). The working copy is built automatically from
# data/p1/registry.snapshot.db on first use. See README "P1 registry".
REFERENCE_BACKEND=p1_sqlite
REFERENCE_DB_PATH=data/p1/registry_agent.sqlite
# "Today" for the agent defaults to config.TODAY (2026-10-15). Uncomment only to override it:
# AGENT_TODAY=2026-10-15
# Old single-person mock registry (Nour), if needed:
# REFERENCE_BACKEND=mock_sqlite
# REFERENCE_DB_PATH=data/mock_registry.sqlite

# ---- Output / state -------------------------------------------------------------
RUNS_DIR=runs
# Agent-written state (outbox, registrations, notices); reset with: python reset_state.py
STATE_DB_PATH=runs/agent_state.sqlite
# TRACES_PATH defaults to $RUNS_DIR/traces.jsonl
# ARTIFACTS_DIR defaults to $RUNS_DIR/artifacts
# Font for generated notice PDFs (needs Arabic glyphs). Auto-detected on most systems.
# NOTICE_FONT_PATH=
