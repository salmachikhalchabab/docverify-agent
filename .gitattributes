# Line endings: the repository stores LF; Git converts on checkout where needed.
# Without this, editing on Windows turned every touched file into CRLF and made
# unchanged files look completely changed in diffs.
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.sqlite binary
*.db binary
*.ttf binary
